# ─── Database ─────────────────────────────────────────────────────────────────
# Full JDBC URL for the MySQL database
DB_URL=jdbc:mysql://localhost:3306/nearme

# MySQL credentials
DB_USER=root
DB_PASS=your_password_here

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens — must be at least 32 characters in prod
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Token lifetime in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRY=86400000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Base URL the React app uses to reach the backend
REACT_APP_BACKEND_URL=http://localhost:8080

# Google Maps API key — used for map embeds AND Google Places real-time data
# Enable: Maps Embed API + Places API in Google Cloud Console
REACT_APP_MAP_API_KEY=your_google_maps_api_key_here

# Backend: same key, passed as GOOGLE_PLACES_KEY env var to Spring Boot
GOOGLE_PLACES_KEY=your_google_maps_api_key_here

# ─── Docker Compose (only needed when running via docker-compose) ──────────────
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=nearme
